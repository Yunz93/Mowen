# Copy to .env and adjust. 墨问 / Mowen loads .env automatically on startup.
# Existing real environment variables always win over .env values.

HOST=127.0.0.1
PORT=4310

# Path to the Pi binary (default: pi on your PATH)
PI_BIN=pi

# Where 墨问 stores tasks/sessions (default: ~/.mowen)
# MOWEN_DATA_DIR=~/.mowen

# Folders 墨问 may open. Comma-separated.
# Default if unset: your home directory (or the work folder chosen in Setup)
# MOWEN_ALLOWED_ROOTS=~/Documents

MOWEN_MAX_PROCESSES=3
MOWEN_MUTATIONS=approval
NODE_ENV=development

# Optional: provider API keys (also configurable in the Setup wizard UI).
# These are passed through to Pi. 墨问 never displays them in the UI.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
