# Copy to .env and adjust. ohMyPi loads .env automatically on startup.
# Existing real environment variables always win over .env values.

HOST=127.0.0.1
PORT=4310

# Path to the Pi binary (default: pi on your PATH)
PI_BIN=pi

# Where ohMyPi stores tasks/sessions (default: ~/.ohmypi)
# OHMYPI_DATA_DIR=~/.ohmypi

# Folders ohMyPi may open. Comma-separated.
# Default if unset: your home directory (or the work folder chosen in Setup)
# OHMYPI_ALLOWED_ROOTS=~/Documents

OHMYPI_MAX_PROCESSES=3
OHMYPI_MUTATIONS=approval
NODE_ENV=development

# Optional: provider API keys (also configurable in the Setup wizard UI).
# These are passed through to Pi. ohMyPi never displays them in the UI.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
